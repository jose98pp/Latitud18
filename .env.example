APP_NAME="Latitud 18"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tudominio.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_latitud18
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=tu_password_aqui

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@uhtv.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

UHTV_CACHE_HOMEPAGE_TTL=300
UHTV_CACHE_CATEGORIES_TTL=600
UHTV_CACHE_DASHBOARD_TTL=300
UHTV_ADMIN_NEWS_PER_PAGE=15
UHTV_PUBLIC_NEWS_PER_PAGE=10
UHTV_MAX_IMAGE_SIZE=2048
UHTV_SANITIZE_CONTENT=true
UHTV_LOG_ERRORS=true
UHTV_MAX_TITLE_LENGTH=255
UHTV_MAX_CONTENT_LENGTH=250000
UHTV_LAZY_LOADING=true
UHTV_COMPRESS_IMAGES=true
UHTV_MINIFY_ASSETS=false

IMAGE_AUTO_OPTIMIZE=true
IMAGE_QUALITY=85
IMAGE_BACKUP_ENABLED=true
IMAGE_CDN_ENABLED=false
IMAGE_SCAN_UPLOADS=true
IMAGE_WEBP_CONVERSION=false
IMAGE_AUTO_CLEANUP_ORPHANS=false

PHP_MEMORY_LIMIT=512M
